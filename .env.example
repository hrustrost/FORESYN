# Local PostgreSQL. These values are development-only.
POSTGRES_USER=foresyn
POSTGRES_PASSWORD=foresyn_dev_only
POSTGRES_DB=foresyn
POSTGRES_PORT=5432
DATABASE_URL=postgres://foresyn:foresyn_dev_only@localhost:5432/foresyn

# Backend
FORESYN_BIND_ADDRESS=127.0.0.1:8080
RUST_LOG=foresyn_backend=info

# Historical, confirmation-aware indexer. Never put real credentials in this file.
EVM_RPC_URL=http://127.0.0.1:8545
EVM_CHAIN_ID=31337
FORESYN_CONTRACT_ADDRESS=
FORESYN_DEPLOYMENT_BLOCK=0
INDEXER_CONFIRMATIONS=6
INDEXER_BATCH_SIZE=500
